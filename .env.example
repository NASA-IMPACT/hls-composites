# Settings for `cdk deploy`, read by cdk/settings.py.
# Copy to `.env` for local synth/deploy; in CI these come from the GitHub
# environment's variables (see docs/deployment.md).

STACK_NAME=hls-composites-dev
STAGE=dev

MCP_ACCOUNT_ID=611670965994
MCP_ACCOUNT_REGION=us-west-2
MCP_IAM_PERMISSION_BOUNDARY_ARN=arn:aws:iam::611670965994:policy/mcp-tenantOperator

VPC_ID=vpc-090abb90ed08fb5ac

# Bucket of HLS granules the composites are built from
INPUT_BUCKET_NAME=lp-prod-protected
# Bucket the monthly composites are written to
OUTPUT_BUCKET_NAME=hls-composites-dev

# Role from hls-vi-historical-orchestration that LPDAAC bucket policies allow to
# read. Leave unset to skip the sts:AssumeRole grant entirely.
LPDAAC_READER_ROLE_ARN=arn:aws:iam::611670965994:role/hls-vi-historical-processing-role-dev

PROCESSING_CONTAINER_ECR_URI=018923174646.dkr.ecr.us-west-2.amazonaws.com/hls-composites:latest
PROCESSING_JOB_VCPU=2
PROCESSING_JOB_MEMORY_MB=8000
PROCESSING_JOB_RETRY_ATTEMPTS=3
PROCESSING_JOB_TIMEOUT_HOURS=2
PROCESSING_LOG_GROUP_NAME=hls-composites-processing-dev
PROCESSING_LOG_RETENTION_DAYS=30

MCP_AMI_ID=resolve:ssm:/mcp/amis/aml2023-ecs
BATCH_INSTANCE_CLASSES=C5,C5A,C6A,C6I,M5,M5A,M6A,M6I
BATCH_MAX_VCPU=16
